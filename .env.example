# MarketRank environment template
PORT=4650
NODE_ENV=development

# Storage backend: file (local dev) or postgres (recommended)
STORE_BACKEND=file
STORE_FILE=./backend/data/store.json

# Security + abuse settings
MODERATOR_KEY=replace-with-strong-secret
JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=market-rank
JWT_AUDIENCE=market-rank-api
ALLOWED_ORIGIN=http://localhost:4650
MAX_BODY_BYTES=16384

# Postgres settings (used when STORE_BACKEND=postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketrank
PGSSL=disable

# Redis session + token revocation cache (recommended for production scale)
REDIS_URL=redis://localhost:6379
REDIS_SESSION_PREFIX=market-rank

# Auth email delivery
APP_BASE_URL=http://localhost:4650
EMAIL_DELIVERY_MODE=stdout
EMAIL_OUTBOX_FILE=./backend/data/email-outbox.jsonl
EMAIL_WEBHOOK_URL=
EMAIL_TOKEN_ECHO=true
